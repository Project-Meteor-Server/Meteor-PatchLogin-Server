@* Styles shared by the login and sign-up pages, measured from the retail ffxivlogin page. *@
<style>
html, body { margin: 0; padding: 0; background: #f9f9f9; }
body { font-family: Arial, Helvetica, "Hiragino Kaku Gothic ProN", "MS PGothic", sans-serif; font-size: 13px; color: #222; }
#page { position: relative; width: 750px; height: 458px; margin-left: 6px; }
#logo { position: absolute; left: 0; top: 86px; }
#banner { position: absolute; left: 0; top: 357px; }
#panel { position: absolute; left: 350px; top: 39px; width: 400px; height: 279px; box-sizing: border-box; margin: 0;
