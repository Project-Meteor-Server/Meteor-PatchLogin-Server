	box-shadow: inset 0 0 0 1px #cdcdc9, inset 0 0 0 2px #acaca9, inset 0 0 0 5px #eeeeec; }
#panel .icon, #panel .label, #panel input.text, #panel .note, #panel .button { position: absolute; }
