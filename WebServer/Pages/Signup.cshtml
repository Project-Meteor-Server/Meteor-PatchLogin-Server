@page "/account/content/signup"
@model SignupModel
<!DOCTYPE html>
<html><head>
<meta charset="utf-8">
<title>Create Account</title>
<partial name="_LoginStyle" />
<style>
#panel .note { top: 146px; }
#panel .button { top: 170px; }
#panel .done { position: absolute; left: 17px; top: 60px; width: 364px; text-align: center; font-size: 14px; }
#panel .back { position: absolute; left: 0; top: 236px; width: 100%; text-align: center; }
#panel .back a { color: #af5f01; font-size: 14px; }
</style>
</head>
<body>
<div id="page">
	<img id="logo" src="img/logo.png" width="325" height="175" alt="FINAL FANTASY XIV">
@if (Model.Created)
{
	<div id="panel">
		<p class="done">Account <b>@Model.Username</b> created.</p>
		<a class="button" href="ffxivlogin">Log In</a>
	</div>
}
else
{
	<form id="panel" method="post" autocomplete="off">
		<img class="icon" src="img/lbSQEXId_mem.gif" style="top: 17px">
		<label class="label" for="username" style="top: 21px">Username</label>
		<input class="text" id="username" type="text" name="username" maxlength="@Meteor.Web.Data.User.MaxNameLength" value="@Model.Username" style="top: 21px">

		<img class="icon" src="img/lbSQEXPass_mem.gif" style="top: 50px">
		<label class="label" for="password" style="top: 54px">Password</label>
		<input class="text" id="password" type="password" name="password" style="top: 54px">

		<img class="icon" src="img/lbSQEXPass_mem.gif" style="top: 83px">
		<label class="label" for="repeatPassword" style="top: 87px">Repeat Password</label>
		<input class="text" id="repeatPassword" type="password" name="repeatPassword" style="top: 87px">

		<img class="icon" src="img/lbMail.gif" style="top: 116px">
		<label class="label" for="email" style="top: 120px">E-mail Address</label>
		<input class="text" id="email" type="text" name="email" maxlength="@Meteor.Web.Data.User.MaxEmailLength" value="@Model.Email" style="top: 120px">

		<div class="note">@Model.Error</div>
		<button class="button" type="submit" name="createUser">Sign Up</button>
		<div class="back"><a href="ffxivlogin">Back to login</a></div>
	</form>
}
	<img id="banner" src="img/banner.png" width="750" height="100" alt="">
</div>
</body></html>
